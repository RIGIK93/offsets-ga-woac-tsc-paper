  pages = {152--165},
  issn = {0377-2217},
  doi = {10.1016/0377-2217(89)90318-4},
  urldate = {2026-11-04},
  abstract = {The paper deals with the fixed-time traffic control problem, which consists of finding a periodic schedule for the signals controlling the vehicular traffic in a system of intersections. A traffic model is used which allows for constraints on green durations, conflicts and coordinations. The resulting mathematical model is formulated as an extension of the feasible differential problem of network flow theory over a special graph associated with the intersection system. The fixed-time traffic control problem is proved to be NP-complete in general. A specialized algorithm is proposed for its solution; moreover, an alternative solution method based on mixed-integer linear programming is given. Finally, a real example is modelled and solved.},
  keywords = {network programming,Road transportation,scheduling,traffic control},
  file = {/home/rigik93d/Zotero/storage/KVCB9MU9/Serafini and Ukovich - 1989 - A mathematical model for the fixed-time traffic control problem.pdf;/home/rigik93d/Zotero/storage/I8BBUP67/0377221789903184.html}
}

